{
  "manifest_version": 3,
  "name": "Honoka Lite",
  "version": "1.11.0",
  "description": "Track Notion page visits, analyze token budgets. Works with Honoka MCP server for Notion sync.",
  "permissions": [
    "storage",
    "history"
  ],
  "host_permissions": [
    "https://*.notion.so/*",
    "https://*.notion.site/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.notion.so/*",
        "https://*.notion.site/*",
        "https://notion.so/*",
        "https://*.notion.com/*",
        "https://notion.com/*"
      ],
      "js": [
        "src/content/page-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*",
        "https://*.atlassian.net/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "src/content/web-tracker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
